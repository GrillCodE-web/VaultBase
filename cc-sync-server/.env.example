# CC Sync Server Environment Variables
# Copy this file to .env and fill in your values

# Security - REQUIRED: Change these in production!
# Generate SERVER_SECRET with: openssl rand -hex 32
SERVER_SECRET=change_this_to_64_character_random_hex_string

# Admin Authentication
# Generate with: openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24
ADMIN_USER=admin
ADMIN_PASS=change_this_to_24_character_random_string

# Server Configuration
PORT=3000
NODE_ENV=production

# Database (optional, defaults to ./data.db)
# DB_PATH=./data.db

# Optional: VPS credentials for deployment scripts
# VPS_IP=your_vps_ip_here
# VPS_USER=root
# VPS_PASS=your_vps_password_here
