# DEVOPS-002: staging-экземпляр cc-sync-server.
# Копировать в .env НА staging-сервере (в каталог staging-инстанса) и заполнить.
# Staging живёт отдельно от боя: свой каталог, свой порт, СВОЯ БД и секреты.
# Всё, что помечено <ЗАПОЛНИТЬ>, генерируется локально и в репозиторий не пишется:
#   openssl rand -hex 32        # SERVER_SECRET / SESSION_SECRET
#   openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24   # ADMIN_PASS

# ── Изоляция от боя (главное!) ──────────────────────────────────────────────
# Своя БД и каталог релизов — staging не видит боевые данные и не раздаёт
# боевые апдейты.
DB_PATH=/opt/cc-sync-server-staging/staging.db
RELEASES_DIR=/opt/cc-sync-server-staging/public/releases

# Свой порт (за nginx — отдельный server_name/path); бой: 3000
PORT=3100
NODE_ENV=staging

# Секреты — ОБЯЗАТЕЛЬНО свои, не боевые.
SERVER_SECRET=<ЗАПОЛНИТЬ: openssl rand -hex 32>
SESSION_SECRET=<openssl rand -hex 32, или удалить — выведется из ADMIN_PASS>
ADMIN_USER=admin
ADMIN_PASS=<openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24>

# Админка на другом пути (не как в бою).
ADMIN_PATH=/ghostadmin/staging-<ЗАПОЛНИТЬ-СУФФИКС>

# Публичная база staging-хоста — попадает в download_url релизов.
BASE_URL=https://<staging-host>

# WebSocket: разрешённые origins (домен staging-панели/лендинга); на деве можно не задавать.
# WS_ALLOWED_ORIGINS=https://<staging-host>

# Rate-limit-режим как в бою (loopback за nginx; true позволяет подделать X-Forwarded-For).
TRUST_PROXY=loopback

# Телеметрия: на staging держим короткий retention.
TELEMETRY_RETENTION_DAYS=14
HB_HISTORY_RETENTION_DAYS=14

# Оффлайн-алерт менеджера: на staging порог можно ужесточить.
# MANAGER_OFFLINE_MINUTES=5
