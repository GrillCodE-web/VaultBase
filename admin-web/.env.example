# Admin Web Interface Environment Variables
# Copy this file to .env and fill in your values

# Admin Authentication
# Must match SERVER_SECRET in cc-sync-server/.env
SERVER_SECRET=change_this_to_64_character_random_hex_string

# Admin credentials (must match what's set in cc-sync-server)
ADMIN_USER=admin
ADMIN_PASS=change_this_to_24_character_random_string

# API URL
API_URL=https://api.eulivehub.com
