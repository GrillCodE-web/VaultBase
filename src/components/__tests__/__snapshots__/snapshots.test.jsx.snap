// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`EmptyState snapshots > as table row 1`] = `
<table>
  <tbody>
    <tr>
      <td
        class="p-0"
        colspan="5"
      >
        <div
          class="flex flex-col items-center justify-center gap-2.5 py-[52px] px-5"
        >
          <div
            class="opacity-25"
            style="font-size: 38px; line-height: 1;"
          >
            📭
          </div>
          <div
            class="text-[14px] font-semibold text-text mt-1"
          >
            Empty
          </div>
        </div>
      </td>
    </tr>
  </tbody>
</table>
`;

