exports[`LoadingSpinner snapshots > custom size and color 1`] = `
<div
  aria-label="Loading cards"
  class="spinner inline-block border-2 border-transparent rounded-full"
  role="status"
  style="width: 40px; height: 40px; border-top-color: red;"
/>
`;

exports[`LoadingSpinner snapshots > default 1`] = `
<div
  aria-label="Loading content"
  class="spinner inline-block border-2 border-transparent rounded-full"
  role="status"
  style="width: 20px; height: 20px; border-top-color: var(--accent);"
/>
`;

exports[`LoadingSpinner snapshots > dots 1`] = `
<div
  class="flex gap-1 items-center"
>
  <div
    class="w-1.5 h-1.5 rounded-full bg-accent"
    style="animation: pulse 1.4s ease-in-out infinite; animation-delay: 0s;"
  />
  <div
    class="w-1.5 h-1.5 rounded-full bg-accent"
    style="animation: pulse 1.4s ease-in-out infinite; animation-delay: 0.16s;"
  />
  <div
    class="w-1.5 h-1.5 rounded-full bg-accent"
    style="animation: pulse 1.4s ease-in-out infinite; animation-delay: 0.32s;"
  />
</div>
`;

exports[`ProgressBar snapshots > clamped over 100 1`] = `
<div
  class="w-full"
>
  <div
    class="h-1 bg-border rounded-[2px] overflow-hidden"
  >
    <div
      class="h-full bg-gradient-accent"
      style="width: 100%; transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);"
    />
  </div>
</div>
`;

exports[`ProgressBar snapshots > half with label 1`] = `
<div
  class="w-full"
>
  <div
    class="h-1 bg-border rounded-[2px] overflow-hidden"
  >
    <div
      class="h-full bg-gradient-accent"
      style="width: 50%; transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);"
    />
  </div>
  <div
    class="mt-1 text-[11px] text-text-3 text-right"
  >
    50
    %
  </div>
</div>
`;

