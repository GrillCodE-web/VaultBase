{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC Manager",
  "version": "2.3.0",
  "identifier": "com.ccmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CC Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      },
      {
        "label": "float",
        "title": "Profile",
        "url": "float.html",
        "width": 620,
        "height": 360,
        "resizable": false,
        "decorations": true,
        "alwaysOnTop": true,
        "visible": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' https://api.eulivehub.com https://api.iinapi.com https://api.17track.net; style-src 'self' 'unsafe-inline' blob:; img-src 'self' data: blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://api.eulivehub.com/update"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwMjc2NTkyOERCM0JERTYKUldUbXZiT05rbVVuc05MbnBYMHhhZit3aUFXR3d6RU9OL0h1WUlubjhDbllmbk5uenNpbk1leHUK"
    }
  }
}
