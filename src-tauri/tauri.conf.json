{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VaultBase",
  "version": "2.12.3",
  "identifier": "com.vaultbase.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VaultBase",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": false
      },
      {
        "label": "float",
        "title": "Profile",
        "url": "float.html",
        "width": 380,
        "height": 460,
        "minWidth": 340,
        "minHeight": 320,
        "maxWidth": 600,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' https://sec201-www.otpmanager.pro wss://sec201-www.otpmanager.pro https://api.iinapi.com https://api.17track.net; style-src 'self' 'unsafe-inline' blob:; font-src 'self'; img-src 'self' data: blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests; report-uri https://sec201-www.otpmanager.pro/csp-report"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://sec201-www.otpmanager.pro/update?current_version={{current_version}}"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBQzQzMkUzMUI1RUY2QUYKUldTdjlsNGI0ekxFaWp6dW41b0kwMkJUdFdPdmJld2RPejBrQTdZTms5dmlZaFV6cnY1U2xTSlMK"
    }
  }
}
