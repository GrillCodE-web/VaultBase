{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC Manager",
  "version": "0.1.0",
  "identifier": "com.ccmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CC Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": true
      },
      {
        "label": "float",
        "title": "Profile",
        "url": "float.html",
        "width": 620,
        "height": 360,
        "resizable": false,
        "decorations": true,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "updater": {
      "active": true,
      "endpoints": ["https://api.eulivehub.com/update"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMwQkE3QjI4MUU4MEVBMUMKUldRYzZvQWVLSHU2TUtZSHM1L0pEN2hkb0l2TU8reHdGUlJxZis4djRteVU0ZC9KaURjVzFFL2EK"
    }
  }
}
