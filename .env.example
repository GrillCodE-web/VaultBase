# VaultBase - Root Project Environment Variables
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit actual values to version control

# ─── VPS Deployment ───────────────────────────────────────────
# NOTE: Use SSH keys instead of passwords for production
VPS_HOST=your_vps_host_or_ip
VPS_PASS=your_secure_password_here
# VPS_SSH_KEY=~/.ssh/id_ed25519

# ─── Security & Encryption ────────────────────────────────────
# Master Password (required for first unlock)
# Must be at least 8 characters, use strong password
vaultbase_MASTER_PASSWORD=

# HMAC Secret for encryption (required for production)
# Generate with: openssl rand -hex 32
vaultbase_HMAC_SECRET=

# Installation ID (auto-generated on first run)
vaultbase_INSTALLATION_ID=

# ─── Synchronization ──────────────────────────────────────────
# License Token (for sync server authentication)
vaultbase_LICENSE_TOKEN=

# Sync Server URL (optional, for multi-device sync)
vaultbase_SYNC_URL=https://api.eulivehub.com

# ─── Application Settings ─────────────────────────────────────
# Auto-lock timeout in seconds (default: 300 = 5 minutes)
vaultbase_AUTOLOCK_TIMEOUT=300

# Debug mode (disable for production)
vaultbase_DEBUG=false

# ─── Build Configuration ──────────────────────────────────────
# Vite environment (development, production)
VITE_ENV=production

# Tauri environment
TAURI_ENV_PLATFORM=linux
TAURI_ENV_ARCH=x86_64
TAURI_ENV_DEBUG=false
