# CC Manager - Root Project Environment Variables
# Copy this file to .env and fill in your values

# VPS Deployment (for deploy scripts)
# NOTE: Never commit actual passwords to version control
VPS_HOST=your_vps_host_or_ip
VPS_PASS=your_secure_password_here
# Recommended: Use SSH keys instead of passwords
# VPS_SSH_KEY=~/.ssh/id_ed25519

# Master Password (required for first unlock)
# Must be at least 8 characters
CC_MANAGER_MASTER_PASSWORD=

# HMAC Secret for encryption (required for production)
# Generate with: openssl rand -hex 32
CC_MANAGER_HMAC_SECRET=

# Installation ID (auto-generated on first run)
CC_MANAGER_INSTALLATION_ID=

# License Token (for sync server authentication)
CC_MANAGER_LICENSE_TOKEN=

# Sync Server URL (optional, for multi-device sync)
CC_MANAGER_SYNC_URL=https://api.eulivehub.com

# Auto-lock timeout in seconds (default: 300 = 5 minutes)
CC_MANAGER_AUTOLOCK_TIMEOUT=300

# Debug mode (disable for production)
CC_MANAGER_DEBUG=false
