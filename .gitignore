*.db-wal
*.xlsx
*.csv
*.zip

# Claude Code
.claude/

# Release artifacts (бинарники — не в git, заливаются скриптом publish-release.py)
.release-artifacts/

# Playwright test results
test-results/
playwright-report/

# Environment variables
.env
.env.local
.env.*.local

# Ключи подписи апдейтера — приватный ключ НИКОГДА не коммитить.
# Потеря ключа = невозможность выпускать обновления для уже установленных клиентов.
.secrets/
*.key
!*.key.pub

# Локальная Rust-цепочка. НЕ коммитить: файл фиксирует
# stable-x86_64-pc-windows-gnu, и в CI macOS/Linux падали с
# "target tuple in channel name". Каждый разработчик держит свой,
# пример — src-tauri/rust-toolchain.toml.example
src-tauri/rust-toolchain.toml
